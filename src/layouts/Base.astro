---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { site, links, clean, isPlaceholder } from '@/data/site';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
}

const { title, description = site.description, type = 'website', publishedTime } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(site.ogImage, Astro.site).href;

const sameAs = [links.github, links.githubAlt, links.linkedin, links.x, links.telegram].filter((l) => !isPlaceholder(l)).map(clean);
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  jobTitle: site.role,
  worksFor: { '@type': 'Organization', name: 'DeFa by InvoiceMate' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'FAST-NUCES' },
  knowsAbout: site.keywords.slice(1),
  sameAs,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={site.keywords.join(', ')} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#08090a" data-theme-color />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, ${site.role}`} />
    <meta property="og:locale" content="en_US" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(personLd)} />
    <script is:inline>
      // Runs before paint: apply the saved theme (dark by default) to avoid a flash.
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        var theme = 'dark';
        try {
          theme = localStorage.getItem('theme') === 'light' ? 'light' : 'dark';
        } catch (e) {}
        root.dataset.theme = theme;
        var meta = document.querySelector('[data-theme-color]');
        if (meta) meta.setAttribute('content', theme === 'light' ? '#f7f7f5' : '#08090a');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="ambient" aria-hidden="true"></div>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Reveal on scroll
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }

      // Cursor spotlight
      document.querySelectorAll<HTMLElement>('.spotlight').forEach((el) => {
        el.addEventListener('pointermove', (e) => {
          const r = el.getBoundingClientRect();
          el.style.setProperty('--mx', `${e.clientX - r.left}px`);
          el.style.setProperty('--my', `${e.clientY - r.top}px`);
        });
      });
    </script>
  </body>
</html>
