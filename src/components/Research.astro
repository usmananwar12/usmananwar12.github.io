---
import { getCollection } from 'astro:content';
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
import ChainIcon from './ChainIcon.astro';
import { focusAreas, contests, experiments, audits, type Severity } from '@/data/research';

const writeups = (await getCollection('research', (e) => !e.data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const severityLevels: { key: Severity; label: string }[] = [
  { key: 'high', label: 'High' },
  { key: 'medium', label: 'Medium' },
  { key: 'low', label: 'Low' },
];

const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
---

<section id="research" class="section research" aria-labelledby="research-title">
  <div class="container">
    <SectionHead index="05" label="Security" id="research-title">
      Reading protocols <span class="dim">the way an attacker would.</span>
    </SectionHead>

    <div class="intro" data-reveal>
      <p>
        I audit the protocols I help build before they reach production. Manual, line-by-line review comes first:
        tracing every state transition, every accounting invariant and every role boundary. AI-assisted passes come
        second, to widen coverage, and I measure them against the manual work rather than trust them blindly.
      </p>
    </div>

    <!-- Audits War-Room Dossier -->
    {
      audits.map((a) => {
        const levels = severityLevels.map((l) => ({ ...l, count: a.severity[l.key] }));
        const total = levels.reduce((n, l) => n + l.count, 0);
        return (
          <article class="audit glass-card beam-card spotlight" data-reveal aria-labelledby={`audit-${a.target}`}>
            <div class="scanline" aria-hidden="true"></div>

            <header class="audit-head">
              <div>
                <p class="mono eng">
                  <span class="shield-badge">
                    <ChainIcon name="shield" size={14} />
                    <span>AUDIT DOSSIER</span>
                  </span>
                  <span>{a.engagement}</span>
                </p>
                <h3 class="audit-title" id={`audit-${a.target}`}>
                  {a.target}
                  <span class="dim">{a.subtitle}</span>
                </h3>
              </div>
              <span class="mono period">{a.period}</span>
            </header>

            <div class="results">
              <div class="total">
                <p class="total-num" data-count={total}>
                  {total}
                </p>
                <p class="total-label">Unique findings</p>
              </div>
              <div class="breakdown">
                <div class="bar" aria-hidden="true">
                  {levels
                    .filter((l) => l.count > 0)
                    .map((l) => (
                      <span class={`seg ${l.key}`} style={`flex-grow:${l.count}`} />
                    ))}
                </div>
                <dl class="levels">
                  {levels.map((l) => (
                    <div class:list={['level', { zero: l.count === 0 }]}>
                      <dt>
                        <span class={`sev ${l.key}`} aria-hidden="true" />
                        {l.label}
                      </dt>
                      <dd data-count={l.count}>{l.count}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            </div>

            <div class="audit-meta">
              <div class="meta-box">
                <p class="label mono">Scope</p>
                <p class="scope">{a.scope}</p>
              </div>
              <div class="meta-box">
                <p class="label mono">Method</p>
                <ul class="method">
                  {a.method.map((m) => (
                    <li>{m}</li>
                  ))}
                </ul>
              </div>
            </div>
            <p class="audit-note mono">{a.note}</p>
          </article>
        );
      })
    }

    <!-- Security Tooling -->
    {
      experiments.length > 0 && (
        <div class="block" data-reveal>
          <h3 class="block-title mono">Security tooling</h3>
          <ul class="entries">
            {experiments.map((x) => {
              const Tag = x.href ? 'a' : 'div';
              return (
                <li>
                  <Tag
                    class="entry tool glass-card beam-card spotlight"
                    data-tilt="3"
                    {...(x.href ? { href: x.href, target: '_blank', rel: 'noopener noreferrer' } : {})}
                  >
                    <div class="tool-top">
                      <span class="tool-icon">
                        <ChainIcon name="terminal" size={18} />
                      </span>
                      <span class="et mono">{x.name}</span>
                      <span class="cli-hint mono">$ audit --multi-chain</span>
                      {x.href && (
                        <span class="go-pill" aria-hidden="true">
                          <Icon name="arrow-up-right" size={16} />
                        </span>
                      )}
                    </div>
                    <span class="ed">{x.description}</span>
                    {x.tags && (
                      <span class="tool-tags">
                        {x.tags.map((t) => (
                          <span class="pill">{t}</span>
                        ))}
                      </span>
                    )}
                  </Tag>
                </li>
              );
            })}
          </ul>
        </div>
      )
    }

    <!-- Threat Vectors / Focus Areas -->
    <div class="block" data-reveal>
      <h3 class="block-title mono">What I look for</h3>
      <ul class="focus">
        {
          focusAreas.map((f, i) => (
            <li class="focus-card glass-card spotlight" data-tilt="4">
              <div class="f-head">
                <span class="mono n">VEC_{String(i + 1).padStart(2, '0')}</span>
                <span class="f-dot" aria-hidden="true" />
              </div>
              <p class="ft">{f.title}</p>
              <p class="fd">{f.detail}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Writeups: shown once at least one is published -->
    {
      writeups.length > 0 && (
        <div class="block" data-reveal>
          <h3 class="block-title mono">Writeups &amp; vulnerability research</h3>
          <ul class="entries">
            {writeups.map((w) => (
              <li>
                <a href={`/research/${w.id}/`} class="entry glass-card spotlight">
                  <span class="mono meta">
                    {fmt(w.data.date)} · {w.data.kind}
                  </span>
                  <span class="et">{w.data.title}</span>
                  <span class="ed">{w.data.summary}</span>
                  <Icon name="arrow-up-right" size={16} class="go" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <!-- Contests: shown once at least one is logged -->
    {
      contests.length > 0 && (
        <div class="block" data-reveal>
          <h3 class="block-title mono">Audit contests</h3>
          <ul class="entries">
            {contests.map((c) => {
              const Tag = c.href ? 'a' : 'div';
              return (
                <li>
                  <Tag
                    class="entry glass-card spotlight"
                    {...(c.href ? { href: c.href, target: '_blank', rel: 'noopener noreferrer' } : {})}
                  >
                    <span class="mono meta">
                      {c.date} · {c.platform}
                    </span>
                    <span class="et">{c.protocol}</span>
                    {c.result && <span class="ed">{c.result}</span>}
                  </Tag>
                </li>
              );
            })}
          </ul>
        </div>
      )
    }
  </div>
</section>

<style>
  .research::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    width: min(960px, 90vw);
    height: 1px;
    transform: translateX(-50%);
    background: linear-gradient(90deg, transparent, rgb(var(--accent-rgb) / 0.5), rgb(var(--violet-rgb) / 0.45), transparent);
  }

  .intro {
    max-width: 68ch;
    margin-bottom: 42px;
  }
  .intro p {
    font-size: 17px;
    line-height: 1.72;
    color: var(--fg-muted);
  }

  .label {
    font-size: 11.5px;
    color: var(--accent-text);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 12px;
  }

  /* ---------- Audit War-Room Card ---------- */
  .audit {
    border-radius: 22px;
    margin-bottom: 56px;
    overflow: hidden;
  }
  .audit > *:not(.scanline) {
    position: relative;
    z-index: 1;
    padding-inline: clamp(22px, 4vw, 40px);
  }

  .scanline {
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 120px;
    background: linear-gradient(180deg, transparent, rgb(var(--accent-rgb) / 0.06), transparent);
    pointer-events: none;
    animation: scan-sweep 7s linear infinite;
    z-index: 0;
  }

  .audit-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 18px;
    flex-wrap: wrap;
    padding-block: clamp(24px, 3.5vw, 34px) 26px;
    background: radial-gradient(ellipse 60% 140% at 95% 0%, rgb(var(--accent-rgb) / 0.12), transparent 65%);
  }

  .eng {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    font-size: 12px;
    color: var(--fg-subtle);
  }
  .shield-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px solid rgb(var(--accent-rgb) / 0.35);
    background: rgb(var(--accent-rgb) / 0.1);
    color: var(--accent-text);
    font-size: 11px;
    letter-spacing: 0.06em;
  }

  .audit-title {
    margin-top: 14px;
    font-size: clamp(28px, 4vw, 42px);
    line-height: 1.05;
    font-weight: 620;
    letter-spacing: -0.04em;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 14px;
  }
  .audit-title .dim {
    font-size: 0.52em;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--fg-muted);
  }

  .period {
    font-size: 12px;
    color: var(--fg-muted);
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: rgb(var(--tint) / 0.03);
  }

  /* Severity palette */
  .high {
    --sev: #fb923c;
  }
  .medium {
    --sev: #facc15;
  }
  .low {
    --sev: #38d9ff;
  }

  .results {
    display: grid;
    grid-template-columns: 230px minmax(0, 1fr);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: rgb(var(--tint) / 0.015);
    padding-inline: 0 !important;
  }

  .total {
    padding: 28px clamp(22px, 4vw, 40px);
    border-right: 1px solid var(--line);
  }
  .total-num {
    font-size: clamp(50px, 6vw, 70px);
    line-height: 0.95;
    font-weight: 650;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
    background: linear-gradient(135deg, var(--heading-from), var(--accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .total-label {
    margin-top: 10px;
    font-size: 14px;
    color: var(--fg-muted);
  }

  .breakdown {
    padding: 28px clamp(22px, 4vw, 40px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 22px;
  }

  .bar {
    display: flex;
    gap: 4px;
    height: 10px;
    transform-origin: 0 50%;
    transform: scaleX(0);
    transition: transform 1s var(--ease) 0.2s;
  }
  .audit.is-in .bar {
    transform: scaleX(1);
  }
  .seg {
    flex-basis: 0;
    border-radius: 4px;
    background: var(--sev);
    box-shadow: 0 0 16px -2px var(--sev);
  }

  .levels {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
  }
  .level {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .level dt {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--fg-muted);
  }
  .level dd {
    order: -1;
    margin: 0;
    font-size: clamp(28px, 3vw, 36px);
    line-height: 1;
    font-weight: 600;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }
  .level.zero dd {
    color: var(--fg-subtle);
  }
  .sev {
    width: 9px;
    height: 9px;
    border-radius: 3px;
    background: var(--sev);
    box-shadow: 0 0 10px var(--sev);
    flex: none;
  }

  .audit-meta {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 20px;
    padding-block: 26px 8px;
  }
  .meta-box {
    padding: 18px 20px;
    border-radius: 14px;
    border: 1px solid var(--line);
    background: rgb(var(--tint) / 0.02);
  }
  .scope {
    font-size: 15px;
    line-height: 1.66;
    color: var(--fg-muted);
  }
  .method {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .method li {
    position: relative;
    padding-left: 18px;
    font-size: 14.5px;
    color: var(--fg);
  }
  .method li::before {
    content: '▸';
    position: absolute;
    left: 0;
    top: 0;
    color: var(--accent-text);
  }

  .audit-note {
    padding-block: 18px clamp(24px, 3.5vw, 30px);
    font-size: 12px;
    color: var(--fg-subtle);
  }

  /* ---------- Sub-blocks ---------- */
  .block {
    margin-bottom: 54px;
  }
  .block:last-child {
    margin-bottom: 0;
  }
  .block-title {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 12px;
    font-weight: 500;
    color: var(--accent-text);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 20px;
  }
  .block-title::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--line-strong), transparent);
  }

  /* Tooling / Entries */
  .entries {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .entry {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: clamp(20px, 3vw, 28px);
    border-radius: 18px;
    overflow: hidden;
  }
  .entry > *:not(.go) {
    position: relative;
    z-index: 1;
  }

  .tool-top {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .tool-icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    border: 1px solid rgb(var(--accent-rgb) / 0.35);
    background: rgb(var(--accent-rgb) / 0.1);
    color: var(--accent-text);
  }
  .et {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .cli-hint {
    font-size: 12px;
    color: var(--fg-subtle);
    padding: 4px 10px;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: rgb(var(--tint) / 0.03);
  }
  .go-pill {
    margin-left: auto;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    border: 1px solid rgb(var(--accent-rgb) / 0.35);
    background: rgb(var(--accent-rgb) / 0.1);
    color: var(--accent-text);
    transition: transform 0.3s var(--spring);
  }
  .entry:hover .go-pill {
    transform: translate(2px, -2px) scale(1.08);
  }

  .meta {
    font-size: 11.5px;
    color: var(--accent-text);
  }
  .ed {
    font-size: 15px;
    color: var(--fg-muted);
    line-height: 1.66;
    max-width: 76ch;
  }
  .tool-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px;
  }
  .entry :global(.go) {
    position: absolute;
    right: 22px;
    top: 22px;
    color: var(--fg-subtle);
    transition: transform 0.3s var(--spring), color 0.3s var(--ease);
  }
  .entry:hover :global(.go) {
    color: var(--accent-text);
    transform: translate(2px, -2px);
  }

  /* Focus Areas Grid */
  .focus {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .focus-card {
    padding: 20px 22px;
    border-radius: 16px;
    overflow: hidden;
  }
  .focus-card > * {
    position: relative;
    z-index: 1;
  }
  .f-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
  }
  .n {
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--accent-text);
  }
  .f-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--violet-soft);
    box-shadow: 0 0 10px var(--violet-soft);
  }
  .ft {
    font-size: 16px;
    font-weight: 590;
    letter-spacing: -0.02em;
  }
  .fd {
    margin-top: 6px;
    font-size: 14px;
    line-height: 1.58;
    color: var(--fg-muted);
  }

  @media (max-width: 960px) {
    .focus {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 820px) {
    .audit-meta {
      grid-template-columns: minmax(0, 1fr);
    }
    .results {
      grid-template-columns: minmax(0, 1fr);
    }
    .total {
      border-right: 0;
      border-bottom: 1px solid var(--line);
      display: flex;
      align-items: baseline;
      gap: 16px;
    }
    .total-label {
      margin-top: 0;
    }
  }
  @media (max-width: 580px) {
    .focus {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
