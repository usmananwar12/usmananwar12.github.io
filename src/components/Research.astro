---
import { getCollection } from 'astro:content';
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
import { focusAreas, platforms, contests, experiments, reviews } from '@/data/research';

const writeups = (await getCollection('research', (e) => !e.data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
---

<section id="research" class="section research" aria-labelledby="research-title">
  <div class="container">
    <SectionHead index="05" label="Security Research" id="research-title">
      Reading protocols <span class="dim">the way an attacker would.</span>
    </SectionHead>

    <div class="intro" data-reveal>
      <p>
        Security is where I'm taking my engineering next. It starts with the code I ship: I review DeFi protocols
        before they reach production, and I build tooling to make that review more thorough. Beyond that, I study
        EVM vulnerability classes, write down protocol invariants and test assumptions until they hold or break.
      </p>
      <p class="muted">
        This section is a working log. Writeups, contest results and tools get added here as they're published.
      </p>
    </div>

    <!-- Security reviews -->
    {
      reviews.length > 0 && (
        <div class="block" data-reveal>
          <h3 class="block-title mono">Security reviews</h3>
          <ul class="reviews">
            {reviews.map((r) => (
              <li class="review spotlight">
                <div class="review-meta">
                  <p class="mono rc">{r.context}</p>
                  <p class="rt">{r.target}</p>
                  <p class="mono rm">{r.method}</p>
                </div>
                <div class="review-body">
                  <p class="rs">{r.summary}</p>
                  <dl class="stats">
                    {r.stats.map((s) => (
                      <div>
                        <dt>{s.label}</dt>
                        <dd>{s.value}</dd>
                      </div>
                    ))}
                  </dl>
                  {r.note && <p class="rn">{r.note}</p>}
                </div>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <!-- Focus areas -->
    <div class="block" data-reveal>
      <h3 class="block-title mono">Focus areas</h3>
      <ul class="focus">
        {
          focusAreas.map((f, i) => (
            <li>
              <span class="mono n">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <p class="ft">{f.title}</p>
                <p class="fd">{f.detail}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="cols">
      <!-- Writeups -->
      <div class="block" data-reveal>
        <h3 class="block-title mono">Writeups &amp; vulnerability research</h3>
        {
          writeups.length ? (
            <ul class="entries">
              {writeups.map((w) => (
                <li>
                  <a href={`/research/${w.id}/`} class="entry spotlight">
                    <span class="mono meta">
                      {fmt(w.data.date)} · {w.data.kind}
                    </span>
                    <span class="et">{w.data.title}</span>
                    <span class="ed">{w.data.summary}</span>
                    <Icon name="arrow-up-right" size={16} class="go" />
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <div class="empty">
              <span class="mono state">
                <span class="pulse" aria-hidden="true" />
                in progress
              </span>
              <p>First writeups are being drafted. They'll be published here.</p>
            </div>
          )
        }
      </div>

      <!-- Contests -->
      <div class="block" data-reveal style="--d:1">
        <h3 class="block-title mono">Audit contests</h3>
        {
          contests.length ? (
            <ul class="entries">
              {contests.map((c) => {
                const Tag = c.href ? 'a' : 'div';
                return (
                  <li>
                    <Tag class="entry" {...(c.href ? { href: c.href, target: '_blank', rel: 'noopener noreferrer' } : {})}>
                      <span class="mono meta">
                        {c.date} · {c.platform}
                      </span>
                      <span class="et">{c.protocol}</span>
                      {c.result && <span class="ed">{c.result}</span>}
                    </Tag>
                  </li>
                );
              })}
            </ul>
          ) : (
            <div class="empty">
              <span class="mono state">
                <span class="pulse" aria-hidden="true" />
                getting started
              </span>
              <p>Starting out on competitive audit platforms. Results will be logged here once they're public.</p>
              <ul class="platforms">
                {platforms.map((p) => (
                  <li class="pill">{p}</li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </div>

    <!-- Tools & experiments -->
    <div class="block" data-reveal>
      <h3 class="block-title mono">Tools &amp; experiments</h3>
      {
        experiments.length ? (
          <ul class="entries">
            {experiments.map((x) => {
              const Tag = x.href ? 'a' : 'div';
              return (
                <li>
                  <Tag
                    class="entry tool spotlight"
                    {...(x.href ? { href: x.href, target: '_blank', rel: 'noopener noreferrer' } : {})}
                  >
                    <span class="et mono">{x.name}</span>
                    <span class="ed">{x.description}</span>
                    {x.tags && (
                      <span class="tool-tags">
                        {x.tags.map((t) => (
                          <span class="pill">{t}</span>
                        ))}
                      </span>
                    )}
                    {x.href && <Icon name="arrow-up-right" size={16} class="go" />}
                  </Tag>
                </li>
              );
            })}
          </ul>
        ) : (
          <div class="empty row">
            <span class="mono state">
              <span class="pulse" aria-hidden="true" />
              in the lab
            </span>
            <p>
              Exploring Foundry invariant testing and AI-assisted review workflows. Public tools and experiments will
              be listed here.
            </p>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .research::before {
    /* faint separator glow */
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    width: min(900px, 90vw);
    height: 1px;
    transform: translateX(-50%);
    background: linear-gradient(90deg, transparent, rgba(124, 245, 200, 0.35), transparent);
  }
  .intro {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    column-gap: 48px;
    row-gap: 12px;
    margin-bottom: 56px;
  }
  .intro p {
    grid-column: 2;
    max-width: 66ch;
    font-size: 17px;
    line-height: 1.7;
    color: var(--fg);
  }
  .intro .muted {
    color: var(--fg-subtle);
    font-size: 15px;
  }

  .block {
    border-top: 1px solid var(--line);
    padding-top: 22px;
    margin-bottom: 56px;
  }
  .block-title {
    font-size: 12px;
    font-weight: 400;
    color: var(--fg-subtle);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 22px;
  }

  .focus {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px 40px;
  }
  .focus li {
    display: grid;
    grid-template-columns: 30px 1fr;
    gap: 8px;
  }
  .n {
    font-size: 11.5px;
    color: var(--accent);
    padding-top: 3px;
  }
  .ft {
    font-size: 15.5px;
    font-weight: 540;
    letter-spacing: -0.015em;
  }
  .fd {
    margin-top: 4px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--fg-subtle);
  }

  /* security reviews */
  .review {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 20px 48px;
    padding: 28px;
    margin-inline: -28px;
    border-radius: 14px;
  }
  .rc {
    font-size: 11.5px;
    color: var(--fg-subtle);
  }
  .rt {
    margin-top: 8px;
    font-size: clamp(22px, 2.6vw, 28px);
    font-weight: 580;
    letter-spacing: -0.035em;
  }
  .rm {
    margin-top: 8px;
    font-size: 11.5px;
    line-height: 1.5;
    color: var(--accent);
  }
  .rs {
    max-width: 64ch;
    font-size: 16.5px;
    line-height: 1.65;
    color: var(--fg);
  }
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 48px;
    margin: 24px 0 0;
    padding: 20px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .stats div {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 220px;
  }
  .stats dt {
    font-size: 13.5px;
    line-height: 1.45;
    color: var(--fg-muted);
  }
  .stats dd {
    order: -1;
    margin: 0;
    font-size: 36px;
    line-height: 1;
    font-weight: 580;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }
  .rn {
    margin-top: 20px;
    max-width: 64ch;
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--fg-subtle);
  }

  /* tools */
  .tool {
    padding-block: 20px;
  }
  .tool-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
  }
  .tool .ed {
    max-width: 72ch;
  }

  .cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 48px;
  }

  .entries {
    display: flex;
    flex-direction: column;
  }
  .grid2 {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 48px;
  }
  .entry {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 40px 16px 14px;
    margin-inline: -14px;
    border-radius: 10px;
    transition: background 0.25s var(--ease);
  }
  a.entry:hover {
    background: rgba(255, 255, 255, 0.025);
  }
  .meta {
    font-size: 11.5px;
    color: var(--fg-subtle);
  }
  .et {
    font-size: 16px;
    font-weight: 540;
    letter-spacing: -0.015em;
  }
  .ed {
    font-size: 14px;
    color: var(--fg-muted);
    line-height: 1.55;
  }
  .entry :global(.go) {
    position: absolute;
    right: 14px;
    top: 18px;
    color: var(--fg-subtle);
    transition:
      transform 0.3s var(--ease),
      color 0.3s var(--ease);
  }
  .entry:hover :global(.go) {
    color: var(--fg);
    transform: translate(2px, -2px);
  }

  .empty {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: 22px;
    border: 1px dashed var(--line-strong);
    border-radius: 12px;
    color: var(--fg-muted);
    font-size: 15px;
    line-height: 1.6;
  }
  .empty.row {
    flex-direction: row;
    align-items: baseline;
    gap: 20px;
  }
  .state {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11.5px;
    color: var(--accent);
    white-space: nowrap;
  }
  .pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    animation: blink 2s ease-in-out infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0.25;
    }
  }
  .platforms {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  @media (max-width: 960px) {
    .focus {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 820px) {
    .intro {
      grid-template-columns: 1fr;
    }
    .intro p {
      grid-column: auto;
    }
    .cols,
    .grid2,
    .review {
      grid-template-columns: 1fr;
    }
    .empty.row {
      flex-direction: column;
      gap: 12px;
    }
  }
  @media (max-width: 560px) {
    .focus {
      grid-template-columns: 1fr;
    }
  }
</style>
