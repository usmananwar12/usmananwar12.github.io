---
import { getCollection } from 'astro:content';
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
import { focusAreas, contests, experiments, audits, type Severity } from '@/data/research';

const writeups = (await getCollection('research', (e) => !e.data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const severityLevels: { key: Severity; label: string }[] = [
  { key: 'high', label: 'High' },
  { key: 'medium', label: 'Medium' },
  { key: 'low', label: 'Low' },
];

const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
---

<section id="research" class="section research" aria-labelledby="research-title">
  <div class="container">
    <SectionHead index="05" label="Security" id="research-title">
      Reading protocols <span class="dim">the way an attacker would.</span>
    </SectionHead>

    <div class="intro" data-reveal>
      <p>
        I audit the protocols I help build before they reach production. Manual, line-by-line review comes first:
        tracing every state transition, every accounting invariant and every role boundary. AI-assisted passes come
        second, to widen coverage, and I measure them against the manual work rather than trust them blindly.
      </p>
    </div>

    <!-- Audits -->
    {
      audits.map((a) => {
        const levels = severityLevels.map((l) => ({ ...l, count: a.severity[l.key] }));
        const total = levels.reduce((n, l) => n + l.count, 0);
        return (
          <article class="audit" data-reveal aria-labelledby={`audit-${a.target}`}>
            <header class="audit-head">
              <div>
                <p class="mono eng">{a.engagement}</p>
                <h3 class="audit-title" id={`audit-${a.target}`}>
                  {a.target}
                  <span class="dim">{a.subtitle}</span>
                </h3>
              </div>
              <span class="mono period">{a.period}</span>
            </header>

            <div class="results">
              <div class="total">
                <p class="total-num">{total}</p>
                <p class="total-label">Unique findings</p>
              </div>
              <div class="breakdown">
                <div class="bar" aria-hidden="true">
                  {levels
                    .filter((l) => l.count > 0)
                    .map((l) => (
                      <span class={`seg ${l.key}`} style={`flex-grow:${l.count}`} />
                    ))}
                </div>
                <dl class="levels">
                  {levels.map((l) => (
                    <div class:list={['level', { zero: l.count === 0 }]}>
                      <dt>
                        <span class={`sev ${l.key}`} aria-hidden="true" />
                        {l.label}
                      </dt>
                      <dd>{l.count}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            </div>

            <div class="audit-meta">
              <div>
                <p class="label mono">Scope</p>
                <p class="scope">{a.scope}</p>
              </div>
              <div>
                <p class="label mono">Method</p>
                <ul class="method">
                  {a.method.map((m) => (
                    <li>{m}</li>
                  ))}
                </ul>
              </div>
            </div>
            <p class="audit-note">{a.note}</p>
          </article>
        );
      })
    }

    <!-- Tooling -->
    {
      experiments.length > 0 && (
        <div class="block" data-reveal>
          <h3 class="block-title mono">Security tooling</h3>
          <ul class="entries">
            {experiments.map((x) => {
              const Tag = x.href ? 'a' : 'div';
              return (
                <li>
                  <Tag
                    class="entry tool spotlight"
                    {...(x.href ? { href: x.href, target: '_blank', rel: 'noopener noreferrer' } : {})}
                  >
                    <span class="et mono">{x.name}</span>
                    <span class="ed">{x.description}</span>
                    {x.tags && (
                      <span class="tool-tags">
                        {x.tags.map((t) => (
                          <span class="pill">{t}</span>
                        ))}
                      </span>
                    )}
                    {x.href && <Icon name="arrow-up-right" size={16} class="go" />}
                  </Tag>
                </li>
              );
            })}
          </ul>
        </div>
      )
    }

    <!-- Focus areas -->
    <div class="block" data-reveal>
      <h3 class="block-title mono">What I look for</h3>
      <ul class="focus">
        {
          focusAreas.map((f, i) => (
            <li>
              <span class="mono n">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <p class="ft">{f.title}</p>
                <p class="fd">{f.detail}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Writeups: shown once at least one is published -->
    {
      writeups.length > 0 && (
        <div class="block" data-reveal>
          <h3 class="block-title mono">Writeups &amp; vulnerability research</h3>
          <ul class="entries">
            {writeups.map((w) => (
              <li>
                <a href={`/research/${w.id}/`} class="entry spotlight">
                  <span class="mono meta">
                    {fmt(w.data.date)} · {w.data.kind}
                  </span>
                  <span class="et">{w.data.title}</span>
                  <span class="ed">{w.data.summary}</span>
                  <Icon name="arrow-up-right" size={16} class="go" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <!-- Contests: shown once at least one is logged -->
    {
      contests.length > 0 && (
        <div class="block" data-reveal>
          <h3 class="block-title mono">Audit contests</h3>
          <ul class="entries">
            {contests.map((c) => {
              const Tag = c.href ? 'a' : 'div';
              return (
                <li>
                  <Tag class="entry" {...(c.href ? { href: c.href, target: '_blank', rel: 'noopener noreferrer' } : {})}>
                    <span class="mono meta">
                      {c.date} · {c.platform}
                    </span>
                    <span class="et">{c.protocol}</span>
                    {c.result && <span class="ed">{c.result}</span>}
                  </Tag>
                </li>
              );
            })}
          </ul>
        </div>
      )
    }
  </div>
</section>

<style>
  .research::before {
    /* faint separator glow */
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    width: min(900px, 90vw);
    height: 1px;
    transform: translateX(-50%);
    background: linear-gradient(90deg, transparent, rgb(var(--accent-rgb) / 0.35), transparent);
  }
  .intro {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    column-gap: 48px;
    margin-bottom: 48px;
  }
  .intro p {
    grid-column: 2;
    max-width: 66ch;
    font-size: 17px;
    line-height: 1.7;
    color: var(--fg);
  }

  .label {
    font-size: 11.5px;
    color: var(--fg-subtle);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 10px;
  }

  /* ---------- audit report ---------- */
  .audit {
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--card-bg);
    box-shadow: var(--card-shadow);
    margin-bottom: 64px;
    overflow: hidden;
  }
  .audit > * {
    padding-inline: clamp(20px, 4vw, 40px);
  }
  .audit-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    flex-wrap: wrap;
    padding-block: clamp(24px, 3.5vw, 36px) 28px;
    background: radial-gradient(ellipse 50% 120% at 100% 0%, rgb(var(--accent-rgb) / 0.07), transparent 70%);
  }
  .eng {
    font-size: 12px;
    color: var(--fg-subtle);
  }
  .audit-title {
    margin-top: 10px;
    font-size: clamp(28px, 4vw, 40px);
    line-height: 1.05;
    font-weight: 580;
    letter-spacing: -0.04em;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 14px;
  }
  .audit-title .dim {
    font-size: 0.55em;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--fg-subtle);
  }
  .period {
    font-size: 12px;
    color: var(--fg-subtle);
    padding-top: 2px;
  }

  /* severity palette (markers only; text stays neutral for contrast) */
  .high {
    --sev: #f97316;
  }
  .medium {
    --sev: #eab308;
  }
  .low {
    --sev: #3b82f6;
  }

  .results {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding-inline: 0 !important;
  }
  .total {
    padding: 28px clamp(20px, 4vw, 40px);
    border-right: 1px solid var(--line);
  }
  .total-num {
    font-size: clamp(48px, 6vw, 68px);
    line-height: 0.95;
    font-weight: 600;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
  }
  .total-label {
    margin-top: 10px;
    font-size: 14px;
    color: var(--fg-muted);
  }
  .breakdown {
    padding: 28px clamp(20px, 4vw, 40px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 22px;
  }
  .bar {
    display: flex;
    gap: 3px;
    height: 8px;
  }
  .seg {
    flex-basis: 0;
    border-radius: 3px;
    background: var(--sev);
  }
  .levels {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
  }
  .level {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .level dt {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--fg-muted);
  }
  .level dd {
    order: -1;
    margin: 0;
    font-size: clamp(26px, 3vw, 34px);
    line-height: 1;
    font-weight: 580;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }
  .level.zero dd {
    color: var(--fg-subtle);
  }
  .sev {
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--sev);
    flex: none;
  }

  .audit-meta {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 24px 48px;
    padding-block: 28px 8px;
  }
  .scope {
    font-size: 15px;
    line-height: 1.65;
    color: var(--fg-muted);
    max-width: 60ch;
  }
  .method {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .method li {
    position: relative;
    padding-left: 18px;
    font-size: 15px;
    color: var(--fg);
  }
  .method li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 8px;
    height: 1px;
    background: var(--accent);
  }
  .audit-note {
    padding-block: 20px clamp(24px, 3.5vw, 32px);
    font-size: 13.5px;
    color: var(--fg-subtle);
  }

  /* ---------- blocks ---------- */
  .block {
    border-top: 1px solid var(--line);
    padding-top: 22px;
    margin-bottom: 56px;
  }
  .block:last-child {
    margin-bottom: 0;
  }
  .block-title {
    font-size: 12px;
    font-weight: 400;
    color: var(--fg-subtle);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 22px;
  }

  .focus {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px 40px;
  }
  .focus li {
    display: grid;
    grid-template-columns: 30px 1fr;
    gap: 8px;
  }
  .n {
    font-size: 11.5px;
    color: var(--accent-text);
    padding-top: 3px;
  }
  .ft {
    font-size: 15.5px;
    font-weight: 540;
    letter-spacing: -0.015em;
  }
  .fd {
    margin-top: 4px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--fg-subtle);
  }

  .entries {
    display: flex;
    flex-direction: column;
  }
  .entry {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 40px 16px 14px;
    margin-inline: -14px;
    border-radius: 10px;
    transition: background 0.25s var(--ease);
  }
  a.entry:hover {
    background: rgb(var(--tint) / 0.025);
  }
  .meta {
    font-size: 11.5px;
    color: var(--fg-subtle);
  }
  .et {
    font-size: 16px;
    font-weight: 540;
    letter-spacing: -0.015em;
  }
  .ed {
    font-size: 14px;
    color: var(--fg-muted);
    line-height: 1.55;
  }
  .tool {
    padding-block: 20px;
  }
  .tool .ed {
    max-width: 72ch;
  }
  .tool-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
  }
  .entry :global(.go) {
    position: absolute;
    right: 14px;
    top: 18px;
    color: var(--fg-subtle);
    transition:
      transform 0.3s var(--ease),
      color 0.3s var(--ease);
  }
  .entry:hover :global(.go) {
    color: var(--fg);
    transform: translate(2px, -2px);
  }

  @media (max-width: 960px) {
    .focus {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 820px) {
    .intro {
      grid-template-columns: 1fr;
    }
    .intro p {
      grid-column: auto;
    }
    .audit-meta {
      grid-template-columns: 1fr;
    }
    .results {
      grid-template-columns: 1fr;
    }
    .total {
      border-right: 0;
      border-bottom: 1px solid var(--line);
      display: flex;
      align-items: baseline;
      gap: 14px;
    }
    .total-label {
      margin-top: 0;
    }
  }
  @media (max-width: 560px) {
    .focus {
      grid-template-columns: 1fr;
    }
  }
</style>
