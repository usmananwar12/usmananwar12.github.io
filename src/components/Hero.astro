---
import Icon from './Icon.astro';
import { links, clean, isPlaceholder } from '@/data/site';

const socials = [
  { label: 'GitHub', href: links.github, icon: 'github' as const },
  { label: 'LinkedIn', href: links.linkedin, icon: 'linkedin' as const },
  { label: 'X', href: links.x, icon: 'x' as const },
  { label: 'Telegram', href: links.telegram, icon: 'telegram' as const },
];

const readout = [
  { k: 'role', v: 'Full-Stack Web3 Engineer' },
  { k: 'at', v: 'DeFa by InvoiceMate' },
  { k: 'chains', v: 'EVM · Starknet · Stellar · XRPL · Solana' },
  { k: 'writes', v: 'Solidity · Cairo · Rust · TypeScript' },
  { k: 'builds', v: 'Lending pools · Liquidity · Treasury' },
  { k: 'domain', v: 'DeFi · PayFi · RWA' },
  { k: 'security', v: 'Protocol reviews · ChainSec' },
];

const dev = import.meta.env.DEV;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container">
    <div class="top">
      <p class="eyebrow mono" data-reveal>
        <span class="live" aria-hidden="true"></span>
        Full-Stack Web3 Engineer · DeFa by InvoiceMate
      </p>

      <h1 id="hero-title" data-reveal style="--d:1">
        <span class="name">Usman Anwar</span>
        <span class="headline">
          Building liquidity infrastructure for real-world finance.{' '}
          <span class="dim">Then trying to break it.</span>
        </span>
      </h1>
    </div>

    <div class="grid">
      <div class="copy">
        <p class="lede" data-reveal style="--d:2">
          I ship smart contracts, lending pools and treasury systems across EVM, Starknet, Stellar, XRPL and Solana,
          and the backends and interfaces that put them in front of real businesses. Increasingly, I spend my time on the
          other side of the code: reviewing protocols for the ways they fail.
        </p>

        <div class="cta" data-reveal style="--d:3">
          <a href="#contact" class="btn btn-primary">
            Get in touch <Icon name="arrow-right" />
          </a>
          <a href="#work" class="btn btn-ghost">Selected work</a>
        </div>

        <ul class="socials" data-reveal style="--d:4" aria-label="Profiles">
          {
            socials.map((s) => (
              <li>
                <a
                  href={clean(s.href)}
                  target="_blank"
                  rel="me noopener noreferrer"
                  aria-label={s.label}
                  class:list={[{ placeholder: dev && isPlaceholder(s.href) }]}
                >
                  <Icon name={s.icon} size={17} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <aside class="readout spotlight" data-reveal style="--d:3" aria-label="At a glance">
        <div class="readout-head mono">
          <span>usman.anwar</span>
          <span class="status"><span class="live" aria-hidden="true"></span>shipping</span>
        </div>
        <dl>
          {
            readout.map((r) => (
              <div class="row">
                <dt class="mono">{r.k}</dt>
                <dd>{r.v}</dd>
              </div>
            ))
          }
        </dl>
        <div class="readout-foot mono">
          <span>BS Computer Science</span>
          <span>FAST-NUCES</span>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(72px, 12vw, 140px);
    padding-bottom: clamp(72px, 10vw, 120px);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
    margin-top: clamp(40px, 5vw, 56px);
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 12.5px;
    color: var(--fg-muted);
    padding: 6px 12px 6px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.02);
    margin-bottom: 32px;
  }
  .live {
    position: relative;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    flex: none;
  }
  .live::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 1px solid var(--accent);
    opacity: 0;
    animation: ping 2.4s var(--ease) infinite;
  }
  @keyframes ping {
    0% {
      transform: scale(0.6);
      opacity: 0.7;
    }
    100% {
      transform: scale(1.6);
      opacity: 0;
    }
  }

  h1 {
    font-weight: inherit;
  }
  .name {
    display: block;
    font-size: 15px;
    font-weight: 500;
    color: var(--fg-muted);
    letter-spacing: -0.01em;
    margin-bottom: 14px;
  }
  .headline {
    display: block;
    font-size: clamp(38px, 6.4vw, 80px);
    line-height: 1;
    max-width: 15ch;
    letter-spacing: -0.045em;
    font-weight: 580;
    text-wrap: balance;
    background: linear-gradient(180deg, #fff 30%, rgba(255, 255, 255, 0.72));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .headline .dim {
    display: block;
    background: linear-gradient(90deg, var(--fg-subtle), #8b9098);
    -webkit-background-clip: text;
    background-clip: text;
  }
  .lede {
    max-width: 56ch;
    font-size: clamp(16px, 1.6vw, 18px);
    line-height: 1.65;
    color: var(--fg-muted);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }
  .socials {
    display: flex;
    gap: 6px;
    margin-top: 28px;
  }
  .socials a {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    color: var(--fg-subtle);
    transition:
      color 0.2s var(--ease),
      background 0.2s var(--ease);
  }
  .socials a:hover {
    color: var(--fg);
    background: rgba(255, 255, 255, 0.05);
  }

  /* readout panel */
  .readout {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.035), rgba(255, 255, 255, 0.01));
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.05) inset,
      0 30px 80px -30px rgba(0, 0, 0, 0.8);
    overflow: hidden;
  }
  .readout-head,
  .readout-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 18px;
    font-size: 11.5px;
    color: var(--fg-subtle);
  }
  .readout-head {
    border-bottom: 1px solid var(--line);
  }
  .readout-foot {
    border-top: 1px solid var(--line);
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--accent);
  }
  .status .live {
    width: 6px;
    height: 6px;
  }
  dl {
    margin: 0;
    padding: 8px 0;
  }
  .row {
    display: grid;
    grid-template-columns: 84px 1fr;
    gap: 12px;
    padding: 9px 18px;
    font-size: 14px;
    transition: background 0.2s var(--ease);
  }
  .row:hover {
    background: rgba(255, 255, 255, 0.025);
  }
  dt {
    font-size: 12px;
    color: var(--fg-subtle);
    padding-top: 2px;
  }
  dd {
    margin: 0;
    color: var(--fg);
    letter-spacing: -0.01em;
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .readout {
      max-width: 520px;
    }
  }
</style>
