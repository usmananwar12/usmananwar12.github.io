---
import Icon from './Icon.astro';
import ChainIcon from './ChainIcon.astro';
import { links, clean, isPlaceholder } from '@/data/site';

const socials = [
  { label: 'GitHub', href: links.github, icon: 'github' as const },
  { label: 'LinkedIn', href: links.linkedin, icon: 'linkedin' as const },
  { label: 'X', href: links.x, icon: 'x' as const },
  { label: 'Telegram', href: links.telegram, icon: 'telegram' as const },
];

const readout = [
  { k: 'role', v: 'Full-Stack Web3 Engineer' },
  { k: 'at', v: 'DeFa by InvoiceMate' },
  { k: 'chains', v: 'EVM · Starknet · Stellar · XRPL · Solana' },
  { k: 'writes', v: 'Solidity · Cairo · Rust · TypeScript' },
  { k: 'builds', v: 'Lending pools · Liquidity · Treasury' },
  { k: 'domain', v: 'DeFi · PayFi · RWA' },
  { k: 'security', v: 'Protocol audits · ChainSec' },
];

const interactiveChains = [
  { id: 'evm', label: 'EVM', vm: 'Solidity · Foundry', color: '#38d9ff' },
  { id: 'starknet', label: 'Starknet', vm: 'Cairo · ZK Rollup', color: '#a78bfa' },
  { id: 'stellar', label: 'Stellar', vm: 'Soroban · PayFi Rails', color: '#2dffc4' },
  { id: 'xrpl', label: 'XRPL', vm: 'Institutional Settlement', color: '#60a5fa' },
  { id: 'solana', label: 'Solana', vm: 'Rust · High-Throughput', color: '#c084fc' },
] as const;

const marqueeItems = [
  { label: 'Ethereum / EVM', icon: 'evm' as const, accent: '#38d9ff' },
  { label: 'Starknet · Cairo', icon: 'starknet' as const, accent: '#a78bfa' },
  { label: 'Stellar', icon: 'stellar' as const, accent: '#2dffc4' },
  { label: 'XRPL', icon: 'xrpl' as const, accent: '#60a5fa' },
  { label: 'Solana', icon: 'solana' as const, accent: '#c084fc' },
  { label: 'Solidity Smart Contracts', icon: 'solidity' as const, accent: '#2dffc4' },
  { label: 'DeFi & PayFi Liquidity', icon: 'liquidity' as const, accent: '#38d9ff' },
  { label: 'Protocol Security Audits', icon: 'shield' as const, accent: '#f97316' },
  { label: 'ChainSec AI Audits', icon: 'terminal' as const, accent: '#2dffc4' },
  { label: 'RWA & Treasury Systems', icon: 'vault' as const, accent: '#a78bfa' },
];

const dev = import.meta.env.DEV;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-left">
        <div class="eyebrow-row hero-anim" style="--hd:0">
          <p class="eyebrow mono">
            <span class="live" aria-hidden="true"></span>
            <span>Full-Stack Web3 Engineer · DeFa by InvoiceMate</span>
          </p>
        </div>

        <h1 id="hero-title" class="hero-anim" style="--hd:1">
          <span class="name mono">
            <span class="prompt" aria-hidden="true">0x</span>Usman Anwar
          </span>
          <span class="headline">
            Building liquidity infrastructure for real-world finance.{' '}
            <span class="dim">Then trying to break it.</span>
          </span>
        </h1>

        <p class="lede hero-anim" style="--hd:2">
          I ship smart contracts, lending pools and treasury systems across EVM, Starknet, Stellar, XRPL and Solana,
          and the backends and interfaces that put them in front of real businesses. Then I audit them, line by line,
          for the ways they fail, before they ship.
        </p>

        <div class="cta hero-anim" style="--hd:3">
          <a href="#contact" class="btn btn-primary" data-magnetic>
            Get in touch <Icon name="arrow-right" />
          </a>
          <a href="#work" class="btn btn-ghost" data-magnetic>
            <ChainIcon name="cube" size={16} />
            Selected work
          </a>
        </div>

        <div class="social-bar hero-anim" style="--hd:4">
          <ul class="socials" aria-label="Profiles">
            {
              socials.map((s) => (
                <li>
                  <a
                    href={clean(s.href)}
                    target="_blank"
                    rel="me noopener noreferrer"
                    aria-label={s.label}
                    class:list={['social-btn', { placeholder: dev && isPlaceholder(s.href) }]}
                  >
                    <Icon name={s.icon} size={17} />
                  </a>
                </li>
              ))
            }
          </ul>
          <span class="hash-chip mono" aria-hidden="true" data-live-hash>tx: 0x7f3a...e91c</span>
        </div>
      </div>

      <!-- Interactive 3D Web3 Protocol & Node Console -->
      <aside class="console glass-card beam-card spotlight hero-anim" data-tilt="4" style="--hd:2" aria-label="At a glance">
        <div class="console-top mono">
          <div class="win-dots" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
          <span class="node-id">usman.anwar.eth</span>
          <span class="status"><span class="live" aria-hidden="true"></span>shipping</span>
        </div>

        <!-- 3D Rotating Cryptographic Octahedron & Multi-Chain Topology Visualizer -->
        <div class="stage" data-chain-stage>
          <canvas class="crystal-canvas" data-crystal-canvas aria-hidden="true"></canvas>
          <div class="stage-overlay mono">
            <span class="stage-badge" data-chain-badge>EVM · Solidity · Foundry</span>
            <span class="stage-hint">interactive node</span>
          </div>
          <div class="chain-switcher" role="tablist" aria-label="Active ecosystems">
            {
              interactiveChains.map((c, idx) => (
                <button
                  type="button"
                  role="tab"
                  aria-selected={idx === 0 ? 'true' : 'false'}
                  class:list={['chain-btn mono', { active: idx === 0 }]}
                  style={`--c-accent:${c.color}`}
                  data-chain-select={c.id}
                  data-chain-vm={`${c.label} · ${c.vm}`}
                  data-chain-color={c.color}
                >
                  <ChainIcon name={c.id} size={13} />
                  <span>{c.label}</span>
                </button>
              ))
            }
          </div>
        </div>

        <dl class="readout-list">
          {
            readout.map((r) => (
              <div class="row">
                <dt class="mono">{r.k}</dt>
                <dd>{r.v}</dd>
              </div>
            ))
          }
        </dl>

        <div class="console-foot mono">
          <span>BS Computer Science</span>
          <span class="edu-pill">FAST-NUCES</span>
        </div>
      </aside>
    </div>
  </div>

  <!-- Continuous Multi-Chain & Web3 Primitives Ticker -->
  <div class="marquee-wrap" aria-label="Web3 ecosystems and focus areas">
    <div class="marquee-track">
      {
        marqueeItems.map((item) => (
          <div class="m-chip" style={`--m-accent:${item.accent}`}>
            <span class="m-icon">
              <ChainIcon name={item.icon} size={16} />
            </span>
            <span class="mono">{item.label}</span>
          </div>
        ))
      }
      {
        marqueeItems.map((item) => (
          <div class="m-chip m-dup" aria-hidden="true" style={`--m-accent:${item.accent}`}>
            <span class="m-icon">
              <ChainIcon name={item.icon} size={16} />
            </span>
            <span class="mono">{item.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(44px, 7vw, 84px);
    padding-bottom: clamp(32px, 5vw, 56px);
    position: relative;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(0, 0.92fr);
    gap: clamp(36px, 5vw, 72px);
    align-items: center;
  }
  .hero-left {
    min-width: 0;
  }
  .hero-anim {
    animation: hero-enter 0.65s var(--ease) both;
    animation-delay: calc(var(--hd, 0) * 70ms);
  }
  @keyframes hero-enter {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    max-width: 100%;
    font-size: 12px;
    line-height: 1.4;
    letter-spacing: 0.02em;
    color: var(--fg);
    padding: 7px 14px 7px 12px;
    border: 1px solid rgb(var(--accent-rgb) / 0.3);
    border-radius: 999px;
    background: linear-gradient(90deg, rgb(var(--accent-rgb) / 0.1), rgb(var(--violet-rgb) / 0.08));
    backdrop-filter: blur(12px);
    box-shadow: 0 0 28px -10px rgb(var(--accent-rgb) / 0.5);
    margin-bottom: 26px;
  }

  h1 {
    font-weight: inherit;
  }

  .name {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 500;
    color: var(--accent-text);
    letter-spacing: 0.03em;
    margin-bottom: 14px;
  }
  .name .prompt {
    color: var(--violet-soft);
    opacity: 0.9;
  }

  .headline {
    display: block;
    font-size: clamp(36px, 5.4vw, 68px);
    line-height: 1.03;
    max-width: 15.5ch;
    letter-spacing: -0.045em;
    font-weight: 620;
    text-wrap: balance;
    background: linear-gradient(125deg, var(--heading-from) 10%, var(--heading-mid) 52%, var(--heading-to) 95%);
    background-size: 200% 200%;
    animation: gradient-shift 9s ease infinite;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .headline .dim {
    display: block;
    margin-top: 6px;
    background: linear-gradient(95deg, var(--accent), var(--cyan) 48%, var(--violet-soft));
    background-size: 200% 200%;
    animation: gradient-shift 7s ease infinite;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .lede {
    margin-top: 26px;
    max-width: 55ch;
    font-size: clamp(16px, 1.55vw, 17.5px);
    line-height: 1.7;
    color: var(--fg-muted);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }

  .social-bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 28px;
  }

  .socials {
    display: flex;
    gap: 8px;
  }

  .social-btn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 11px;
    border: 1px solid var(--line);
    background: rgb(var(--tint) / 0.03);
    backdrop-filter: blur(8px);
    color: var(--fg-muted);
    transition:
      color 0.25s var(--ease),
      border-color 0.25s var(--ease),
      background 0.25s var(--ease),
      transform 0.28s var(--spring),
      box-shadow 0.25s var(--ease);
  }
  .social-btn:hover {
    color: var(--accent-text);
    border-color: rgb(var(--accent-rgb) / 0.45);
    background: rgb(var(--accent-rgb) / 0.1);
    transform: translateY(-3px);
    box-shadow: 0 8px 24px -8px rgb(var(--accent-rgb) / 0.55);
  }

  .hash-chip {
    font-size: 11.5px;
    color: var(--fg-subtle);
    padding: 6px 12px;
    border-radius: 8px;
    border: 1px dashed var(--line);
    background: rgb(var(--tint) / 0.02);
    letter-spacing: 0.03em;
  }

  /* ---------- Web3 Node Console Card ---------- */
  .console {
    border-radius: 20px;
    overflow: hidden;
  }

  .console-top,
  .console-foot {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 18px;
    font-size: 11.5px;
    color: var(--fg-subtle);
  }
  .console-top {
    border-bottom: 1px solid var(--line);
    background: rgb(var(--tint) / 0.02);
  }
  .console-foot {
    border-top: 1px solid var(--line);
    background: rgb(var(--tint) / 0.02);
  }

  .win-dots {
    display: flex;
    gap: 6px;
  }
  .win-dots span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--line-strong);
  }
  .win-dots span:nth-child(1) {
    background: rgb(255 95 86 / 0.75);
  }
  .win-dots span:nth-child(2) {
    background: rgb(255 189 46 / 0.75);
  }
  .win-dots span:nth-child(3) {
    background: rgb(var(--accent-rgb) / 0.85);
  }

  .node-id {
    color: var(--fg-muted);
    letter-spacing: 0.02em;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--accent-text);
  }
  .status .live {
    width: 6px;
    height: 6px;
  }

  /* 3D Interactive Stage inside Console */
  .stage {
    position: relative;
    z-index: 1;
    height: 210px;
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(circle at 50% 45%, rgb(var(--accent-rgb) / 0.14), transparent 62%),
      radial-gradient(circle at 20% 20%, rgb(var(--violet-rgb) / 0.14), transparent 55%);
    overflow: hidden;
  }
  .crystal-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    cursor: grab;
  }
  .crystal-canvas:active {
    cursor: grabbing;
  }

  .stage-overlay {
    position: absolute;
    top: 12px;
    left: 14px;
    right: 14px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    pointer-events: none;
    font-size: 11px;
  }
  .stage-badge {
    padding: 4px 9px;
    border-radius: 999px;
    border: 1px solid rgb(var(--accent-rgb) / 0.3);
    background: rgb(4 6 13 / 0.65);
    color: var(--accent-text);
    backdrop-filter: blur(8px);
  }
  :root[data-theme='light'] .stage-badge {
    background: rgb(255 255 255 / 0.85);
  }
  .stage-hint {
    color: var(--fg-subtle);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .chain-switcher {
    position: absolute;
    bottom: 10px;
    left: 10px;
    right: 10px;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 6px;
  }
  .chain-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 26px;
    padding: 0 9px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: rgb(4 6 13 / 0.65);
    backdrop-filter: blur(8px);
    color: var(--fg-muted);
    font-size: 11px;
    cursor: pointer;
    transition:
      border-color 0.25s var(--ease),
      color 0.25s var(--ease),
      background 0.25s var(--ease),
      transform 0.25s var(--spring),
      box-shadow 0.25s var(--ease);
  }
  :root[data-theme='light'] .chain-btn {
    background: rgb(255 255 255 / 0.86);
  }
  .chain-btn:hover,
  .chain-btn.active {
    color: var(--c-accent);
    border-color: color-mix(in srgb, var(--c-accent) 60%, transparent);
    background: color-mix(in srgb, var(--c-accent) 14%, rgb(4 6 13 / 0.72));
    box-shadow: 0 0 18px -6px var(--c-accent);
    transform: translateY(-1px);
  }
  :root[data-theme='light'] .chain-btn:hover,
  :root[data-theme='light'] .chain-btn.active {
    color: var(--fg);
    background: color-mix(in srgb, var(--c-accent) 16%, #ffffff);
  }

  .readout-list {
    position: relative;
    z-index: 1;
    margin: 0;
    padding: 6px 0;
  }
  .row {
    display: grid;
    grid-template-columns: 82px 1fr;
    gap: 12px;
    padding: 8px 18px;
    font-size: 13.5px;
    transition: background 0.2s var(--ease);
  }
  .row:hover {
    background: rgb(var(--accent-rgb) / 0.05);
  }
  dt {
    font-size: 11.5px;
    color: var(--accent-text);
    opacity: 0.85;
    padding-top: 2px;
  }
  dd {
    margin: 0;
    color: var(--fg);
    letter-spacing: -0.01em;
  }

  .edu-pill {
    padding: 2px 8px;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--fg-muted);
  }

  /* ---------- Multi-Chain Ecosystem Marquee ---------- */
  .marquee-wrap {
    margin-top: clamp(52px, 7vw, 84px);
    padding-block: 18px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: linear-gradient(90deg, transparent, rgb(var(--accent-rgb) / 0.035) 50%, transparent);
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }

  .marquee-track {
    display: flex;
    gap: 14px;
    width: max-content;
    animation: marquee-scroll 34s linear infinite;
  }
  .marquee-wrap:hover .marquee-track {
    animation-play-state: paused;
  }

  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .m-chip {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 8px 15px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--card-bg);
    backdrop-filter: blur(10px);
    font-size: 12.5px;
    color: var(--fg-muted);
    white-space: nowrap;
    transition:
      border-color 0.25s var(--ease),
      color 0.25s var(--ease),
      transform 0.25s var(--spring),
      box-shadow 0.25s var(--ease);
  }
  .m-chip:hover {
    color: var(--fg);
    border-color: color-mix(in srgb, var(--m-accent) 55%, transparent);
    box-shadow: 0 0 22px -8px var(--m-accent);
    transform: translateY(-2px);
  }
  .m-icon {
    display: grid;
    place-items: center;
    color: var(--m-accent);
  }

  @media (max-width: 980px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .console {
      width: 100%;
      max-width: 560px;
      min-width: 0;
    }
  }
  @media (max-width: 520px) {
    .eyebrow {
      font-size: 11px;
      border-radius: 14px;
    }
    .row {
      grid-template-columns: 70px minmax(0, 1fr);
      padding-inline: 14px;
      font-size: 13px;
    }
    .stage-hint {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-anim {
      animation: none;
      opacity: 1;
      transform: none;
    }
    .marquee-track {
      animation: none;
      flex-wrap: wrap;
      width: auto;
      justify-content: center;
      padding-inline: var(--gutter);
    }
    .m-dup {
      display: none;
    }
  }
</style>

<script>
  // 1. Live cycling synthetic tx hash micro-detail
  const hashEl = document.querySelector<HTMLElement>('[data-live-hash]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hex = '0123456789abcdef';
  const randHex = (n: number) => Array.from({ length: n }, () => hex[Math.floor(Math.random() * 16)]).join('');

  if (hashEl && !reducedMotion) {
    window.setInterval(() => {
      hashEl.textContent = `tx: 0x${randHex(4)}...${randHex(4)}`;
    }, 3400);
  }

  // 2. Interactive 3D Rotating Cryptographic Octahedron + Orbiting Chain Satellites
  const crystalCanvas = document.querySelector<HTMLCanvasElement>('[data-crystal-canvas]');
  const stageBadge = document.querySelector<HTMLElement>('[data-chain-badge]');
  const chainBtns = document.querySelectorAll<HTMLButtonElement>('[data-chain-select]');

  if (crystalCanvas) {
    const ctx = crystalCanvas.getContext('2d');
    if (ctx) {
      let w = 0;
      let h = 0;
      let dpr = Math.min(window.devicePixelRatio || 1, 2);

      let activeColor = '#38d9ff';
      let pulseBoost = 0;

      // Vertices of an iconic Web3 double-pyramid crystal + inner core
      const outerVerts: [number, number, number][] = [
        [0, -1.45, 0],
        [0.98, 0, 0],
        [0, 0, 0.98],
        [-0.98, 0, 0],
        [0, 0, -0.98],
        [0, 1.45, 0],
      ];
      const outerEdges: [number, number][] = [
        [0, 1], [0, 2], [0, 3], [0, 4],
        [5, 1], [5, 2], [5, 3], [5, 4],
        [1, 2], [2, 3], [3, 4], [4, 1],
      ];
      const outerFaces: [number, number, number][] = [
        [0, 1, 2], [0, 2, 3], [0, 3, 4], [0, 4, 1],
        [5, 2, 1], [5, 3, 2], [5, 4, 3], [5, 1, 4],
      ];

      let rotX = 0.28;
      let rotY = 0;
      let velY = 0.011;
      let drag = false;
      let lastX = 0;
      let raf = 0;

      const resize = () => {
        const rect = crystalCanvas.getBoundingClientRect();
        w = rect.width;
        h = rect.height;
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        crystalCanvas.width = Math.floor(w * dpr);
        crystalCanvas.height = Math.floor(h * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      };

      const hexToRgb = (hexStr: string) => {
        const c = hexStr.replace('#', '');
        const num = parseInt(c, 16);
        return `${(num >> 16) & 255}, ${(num >> 8) & 255}, ${num & 255}`;
      };

      const project = (vx: number, vy: number, vz: number, scaleBase: number) => {
        const cy = Math.cos(rotY);
        const sy = Math.sin(rotY);
        const cx = Math.cos(rotX);
        const sx = Math.sin(rotX);

        const x1 = vx * cy - vz * sy;
        const z1 = vx * sy + vz * cy;
        const y2 = vy * cx - z1 * sx;
        const z2 = vy * sx + z1 * cx;

        const fov = 3.6;
        const p = fov / (fov + z2 * 0.55);
        return { x: w * 0.5 + x1 * scaleBase * p, y: h * 0.44 + y2 * scaleBase * p, z: z2 };
      };

      const draw = (t: number) => {
        ctx.clearRect(0, 0, w, h);
        const rgb = hexToRgb(activeColor);
        const isLight = document.documentElement.dataset.theme === 'light';
        const baseScale = Math.min(w, h) * 0.255 * (1 + pulseBoost * 0.08);

        if (!reducedMotion) {
          if (!drag) {
            rotY += velY;
            velY += (0.011 - velY) * 0.04;
          }
          pulseBoost *= 0.92;
        }

        // Orbital rings representing multi-chain consensus
        const orbitRx = baseScale * 2.15;
        const orbitRy = baseScale * 0.62;
        ctx.save();
        ctx.translate(w * 0.5, h * 0.44);
        ctx.rotate(-0.18);
        ctx.strokeStyle = `rgba(${rgb}, ${isLight ? 0.26 : 0.24})`;
        ctx.lineWidth = 1;
        ctx.setLineDash([4, 5]);
        ctx.beginPath();
        ctx.ellipse(0, 0, orbitRx, orbitRy, 0, 0, Math.PI * 2);
        ctx.stroke();
        ctx.setLineDash([]);

        // 5 orbiting ecosystem satellite nodes
        const satColors = ['56, 217, 255', '167, 139, 250', '45, 255, 196', '96, 165, 250', '192, 132, 252'];
        for (let i = 0; i < 5; i++) {
          const angle = t * 0.00075 + (i * Math.PI * 2) / 5;
          const sx = Math.cos(angle) * orbitRx;
          const sy = Math.sin(angle) * orbitRy;
          const depth = (Math.sin(angle) + 1) * 0.5;
          const r = 2.2 + depth * 2.1;

          ctx.fillStyle = `rgba(${satColors[i]}, ${0.35 + depth * 0.65})`;
          ctx.beginPath();
          ctx.arc(sx, sy, r, 0, Math.PI * 2);
          ctx.fill();

          ctx.fillStyle = `rgba(${satColors[i]}, ${0.14 + depth * 0.14})`;
          ctx.beginPath();
          ctx.arc(sx, sy, r * 2.6, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.restore();

        // Project crystal vertices
        const pts = outerVerts.map(([vx, vy, vz]) => project(vx, vy, vz, baseScale));

        // Translucent glowing glass facets
        for (const [a, b, c] of outerFaces) {
          const pa = pts[a];
          const pb = pts[b];
          const pc = pts[c];
          const avgZ = (pa.z + pb.z + pc.z) / 3;
          const shade = Math.max(0.05, Math.min(0.26, 0.14 - avgZ * 0.08));

          ctx.fillStyle = `rgba(${rgb}, ${shade + pulseBoost * 0.12})`;
          ctx.beginPath();
          ctx.moveTo(pa.x, pa.y);
          ctx.lineTo(pb.x, pb.y);
          ctx.lineTo(pc.x, pc.y);
          ctx.closePath();
          ctx.fill();
        }

        // Wireframe edges
        ctx.strokeStyle = `rgba(${rgb}, ${isLight ? 0.78 : 0.85})`;
        ctx.lineWidth = 1.25;
        ctx.beginPath();
        for (const [a, b] of outerEdges) {
          ctx.moveTo(pts[a].x, pts[a].y);
          ctx.lineTo(pts[b].x, pts[b].y);
        }
        ctx.stroke();

        // Inner glowing zk-core
        const innerPts = outerVerts.map(([vx, vy, vz]) => project(vx * 0.45, vy * 0.45, vz * 0.45, baseScale));
        ctx.strokeStyle = `rgba(45, 255, 196, ${isLight ? 0.5 : 0.6})`;
        ctx.lineWidth = 0.85;
        ctx.beginPath();
        for (const [a, b] of outerEdges) {
          ctx.moveTo(innerPts[a].x, innerPts[a].y);
          ctx.lineTo(innerPts[b].x, innerPts[b].y);
        }
        ctx.stroke();

        // Bright vertex nodes
        for (const pt of pts) {
          ctx.fillStyle = `rgba(${rgb}, 0.95)`;
          ctx.beginPath();
          ctx.arc(pt.x, pt.y, 2.3, 0, Math.PI * 2);
          ctx.fill();
        }

        if (!reducedMotion) {
          raf = requestAnimationFrame(draw);
        }
      };

      resize();
      draw(0);

      window.addEventListener('resize', () => {
        resize();
        if (reducedMotion) draw(0);
      });

      // Drag to spin the 3D crystal!
      crystalCanvas.addEventListener('pointerdown', (e) => {
        drag = true;
        lastX = e.clientX;
        crystalCanvas.setPointerCapture(e.pointerId);
      });
      crystalCanvas.addEventListener('pointermove', (e) => {
        if (!drag) return;
        const dx = e.clientX - lastX;
        lastX = e.clientX;
        rotY += dx * 0.015;
        velY = dx * 0.004;
      });
      crystalCanvas.addEventListener('pointerup', () => {
        drag = false;
      });
      crystalCanvas.addEventListener('pointercancel', () => {
        drag = false;
      });

      // Ecosystem tab switcher updates crystal energy & spin impulse
      chainBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          chainBtns.forEach((b) => {
            b.classList.remove('active');
            b.setAttribute('aria-selected', 'false');
          });
          btn.classList.add('active');
          btn.setAttribute('aria-selected', 'true');
          activeColor = btn.dataset.chainColor || '#38d9ff';
          if (stageBadge) stageBadge.textContent = btn.dataset.chainVm || '';
          velY = 0.095;
          pulseBoost = 1;
          if (reducedMotion) draw(0);
        });
      });

      document.addEventListener('visibilitychange', () => {
        if (reducedMotion) return;
        if (document.hidden) cancelAnimationFrame(raf);
        else raf = requestAnimationFrame(draw);
      });
    }
  }
</script>
