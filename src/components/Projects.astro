---
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
import ChainIcon from './ChainIcon.astro';
import { projects } from '@/data/projects';
import { links, clean } from '@/data/site';

type IconName = 'liquidity' | 'starknet' | 'network' | 'vault' | 'terminal' | 'identity' | 'cube';

const visualMeta: Record<string, { icon: IconName; accent: string; category: 'defi' | 'security' }> = {
  PayMate: { icon: 'liquidity', accent: '#2dffc4', category: 'defi' },
  CredMate: { icon: 'starknet', accent: '#a78bfa', category: 'defi' },
  'DeFa Marketplace': { icon: 'network', accent: '#38d9ff', category: 'defi' },
  'Private RWA & Lending': { icon: 'vault', accent: '#60a5fa', category: 'defi' },
  ChainSec: { icon: 'terminal', accent: '#f97316', category: 'security' },
  DeKYC: { icon: 'identity', accent: '#c084fc', category: 'security' },
};

const filters = [
  { id: 'all', label: 'All Protocols', count: projects.length },
  {
    id: 'defi',
    label: 'PayFi · DeFi · RWA',
    count: projects.filter((p) => (visualMeta[p.name]?.category ?? 'defi') === 'defi').length,
  },
  {
    id: 'security',
    label: 'Security · Identity',
    count: projects.filter((p) => visualMeta[p.name]?.category === 'security').length,
  },
];
---

<section id="work" class="section" aria-labelledby="work-title">
  <div class="container">
    <SectionHead index="03" label="Selected Work" id="work-title">
      Protocols and products <span class="dim">I've helped build.</span>
    </SectionHead>

    <div class="filter-bar" role="tablist" aria-label="Filter projects" data-reveal>
      {
        filters.map((f, idx) => (
          <button
            type="button"
            role="tab"
            aria-selected={idx === 0 ? 'true' : 'false'}
            class:list={['filter-btn mono', { active: idx === 0 }]}
            data-project-filter={f.id}
          >
            <span>{f.label}</span>
            <span class="f-count">{f.count}</span>
          </button>
        ))
      }
    </div>

    <ul class="project-grid" data-project-grid>
      {
        projects.map((p, i) => {
          const Tag = p.href ? 'a' : 'div';
          const meta = visualMeta[p.name] ?? { icon: 'cube' as const, accent: '#2dffc4', category: 'defi' };
          return (
            <li data-reveal data-category={meta.category} style={`--d:${i % 4}`}>
              <Tag
                class:list={['p-card glass-card spotlight', { linked: !!p.href, 'beam-card': !!p.href }]}
                data-tilt="4"
                style={`--card-accent:${meta.accent}`}
                {...(p.href ? { href: p.href, target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                <div class="card-glow" aria-hidden="true"></div>

                <header class="card-top">
                  <div class="icon-wrap">
                    <ChainIcon name={meta.icon} size={20} />
                  </div>
                  <div class="meta-right">
                    <span class="mono context">{p.context}</span>
                    <span class="mono idx">0x{String(i + 1).padStart(2, '0')}</span>
                  </div>
                </header>

                <div class="card-body">
                  <div class="title-row">
                    <h3>{p.name}</h3>
                    {p.href && (
                      <span class="launch" aria-hidden="true">
                        <Icon name="arrow-up-right" size={16} />
                      </span>
                    )}
                  </div>
                  <p class="tagline">{p.tagline}</p>
                  <p class="desc">{p.description}</p>
                </div>

                <footer class="card-foot">
                  <ul class="tags" aria-label="Tags">
                    {p.tags.map((t) => (
                      <li class="pill">{t}</li>
                    ))}
                  </ul>
                </footer>
              </Tag>
            </li>
          );
        })
      }
    </ul>

    <p class="more" data-reveal>
      <a href={clean(links.github)} target="_blank" rel="noopener noreferrer" class="btn btn-ghost" data-magnetic>
        <Icon name="github" size={16} />
        More on GitHub <Icon name="arrow-up-right" />
      </a>
    </p>
  </div>
</section>

<style>
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 28px;
  }
  .filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: rgb(var(--tint) / 0.03);
    backdrop-filter: blur(10px);
    color: var(--fg-muted);
    font-size: 12px;
    cursor: pointer;
    transition:
      color 0.25s var(--ease),
      border-color 0.25s var(--ease),
      background 0.25s var(--ease),
      transform 0.25s var(--spring),
      box-shadow 0.25s var(--ease);
  }
  .filter-btn:hover {
    color: var(--fg);
    border-color: rgb(var(--accent-rgb) / 0.35);
    transform: translateY(-1px);
  }
  .filter-btn.active {
    color: var(--accent-text);
    border-color: rgb(var(--accent-rgb) / 0.5);
    background: rgb(var(--accent-rgb) / 0.12);
    box-shadow: 0 0 22px -8px rgb(var(--accent-rgb) / 0.65);
  }
  .f-count {
    font-size: 10.5px;
    padding: 1px 6px;
    border-radius: 999px;
    background: rgb(var(--tint) / 0.08);
    color: inherit;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .project-grid > li {
    display: flex;
    transition: opacity 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .project-grid > li.is-hidden {
    display: none;
  }

  .p-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    padding: clamp(22px, 3vw, 30px);
    border-radius: 20px;
    overflow: hidden;
  }
  .p-card > *:not(.card-glow) {
    position: relative;
    z-index: 1;
  }

  .card-glow {
    position: absolute;
    top: -60px;
    right: -60px;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--card-accent) 22%, transparent), transparent 68%);
    pointer-events: none;
    opacity: 0.55;
    transition: opacity 0.35s var(--ease), transform 0.45s var(--ease);
    z-index: 0;
  }
  .p-card:hover .card-glow {
    opacity: 1;
    transform: scale(1.22);
  }
  .p-card:hover {
    border-color: color-mix(in srgb, var(--card-accent) 48%, transparent);
    box-shadow:
      var(--card-shadow),
      0 18px 42px -22px color-mix(in srgb, var(--card-accent) 42%, transparent);
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 22px;
  }
  .icon-wrap {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 13px;
    border: 1px solid color-mix(in srgb, var(--card-accent) 38%, transparent);
    background: color-mix(in srgb, var(--card-accent) 12%, transparent);
    color: var(--card-accent);
    box-shadow: 0 0 24px -8px var(--card-accent);
    transition: transform 0.32s var(--spring);
  }
  .p-card:hover .icon-wrap {
    transform: scale(1.08) rotate(-5deg);
  }

  .meta-right {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .context {
    font-size: 11px;
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: rgb(var(--tint) / 0.03);
    color: var(--fg-muted);
  }
  .idx {
    font-size: 11.5px;
    color: var(--card-accent);
    opacity: 0.85;
  }

  .card-body {
    flex: 1;
  }
  .title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  h3 {
    font-size: clamp(21px, 2.4vw, 26px);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.2;
  }
  .launch {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--card-accent) 45%, transparent);
    background: color-mix(in srgb, var(--card-accent) 12%, transparent);
    color: var(--card-accent);
    flex: none;
    transition: transform 0.3s var(--spring), background 0.25s var(--ease);
  }
  .p-card:hover .launch {
    transform: translate(2px, -2px) scale(1.06);
    background: color-mix(in srgb, var(--card-accent) 22%, transparent);
  }

  .tagline {
    margin-top: 6px;
    font-size: 14.5px;
    font-weight: 500;
    color: var(--card-accent);
    opacity: 0.9;
  }
  :root[data-theme='light'] .tagline {
    color: var(--fg-muted);
  }

  .desc {
    margin-top: 14px;
    color: var(--fg-muted);
    font-size: 15px;
    line-height: 1.66;
  }

  .card-foot {
    margin-top: 24px;
    padding-top: 18px;
    border-top: 1px dashed var(--line);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .more {
    margin-top: 34px;
  }

  @media (max-width: 820px) {
    .project-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('[data-project-filter]');
  const cards = document.querySelectorAll<HTMLLIElement>('[data-project-grid] > li');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.projectFilter || 'all';
      filterBtns.forEach((b) => {
        const active = b === btn;
        b.classList.toggle('active', active);
        b.setAttribute('aria-selected', String(active));
      });
      cards.forEach((card) => {
        const match = target === 'all' || card.dataset.category === target;
        card.classList.toggle('is-hidden', !match);
        if (match) card.classList.add('is-in');
      });
    });
  });
</script>
