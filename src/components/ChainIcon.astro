---
/**
 * Custom crisp geometric SVG marks for Web3 ecosystems & protocol primitives.
 * Zero external dependencies; renders sharply at any size.
 */
interface Props {
  name:
    | 'evm'
    | 'starknet'
    | 'stellar'
    | 'xrpl'
    | 'solana'
    | 'solidity'
    | 'cairo'
    | 'shield'
    | 'cube'
    | 'vault'
    | 'network'
    | 'terminal'
    | 'identity'
    | 'liquidity';
  size?: number;
  class?: string;
}

const { name, size = 18, class: className } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.65"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
>
  {/* Ethereum / EVM Octahedron Diamond */}
  {
    name === 'evm' && (
      <>
        <polygon points="12 2 5.5 12.2 12 16 18.5 12.2" fill="currentColor" fill-opacity="0.18" />
        <polyline points="5.5 12.2 12 16 18.5 12.2" />
        <polygon points="12 22 5.5 14.2 12 18 18.5 14.2" fill="currentColor" fill-opacity="0.1" />
        <line x1="12" y1="2" x2="12" y2="16" stroke-opacity="0.6" />
      </>
    )
  }

  {/* Starknet Orbit + Star */}
  {
    name === 'starknet' && (
      <>
        <ellipse cx="12" cy="12" rx="9.5" ry="4.5" transform="rotate(-28 12 12)" />
        <path
          d="M12 5.2 13.4 9.6 17.8 11 13.4 12.4 12 16.8 10.6 12.4 6.2 11 10.6 9.6Z"
          fill="currentColor"
          fill-opacity="0.22"
        />
        <circle cx="18.2" cy="7" r="1.4" fill="currentColor" stroke="none" />
      </>
    )
  }

  {/* Stellar Ringed Planet */}
  {
    name === 'stellar' && (
      <>
        <circle cx="12" cy="12" r="5.2" fill="currentColor" fill-opacity="0.14" />
        <path d="M3.5 15.8 20.5 7.2" />
        <path d="M4.2 18.8 20.2 10.6" />
      </>
    )
  }

  {/* XRPL Dual Interlocking V-Arcs */}
  {
    name === 'xrpl' && (
      <>
        <path d="M4.5 5.5 10.4 10.8a2.4 2.4 0 0 0 3.2 0L19.5 5.5" stroke-width="2" />
        <path d="M4.5 18.5 10.4 13.2a2.4 2.4 0 0 1 3.2 0L19.5 18.5" stroke-width="2" />
      </>
    )
  }

  {/* Solana Tri-Bars */}
  {
    name === 'solana' && (
      <>
        <path d="M5.5 7h12.2l1.8-2.2H7.3L5.5 7Z" fill="currentColor" fill-opacity="0.24" />
        <path d="M18.5 13.1H6.3l-1.8-2.2h12.2l1.8 2.2Z" fill="currentColor" fill-opacity="0.24" />
        <path d="M5.5 19.2h12.2l1.8-2.2H7.3l-1.8 2.2Z" fill="currentColor" fill-opacity="0.24" />
      </>
    )
  }

  {/* Solidity Prism */}
  {
    name === 'solidity' && (
      <>
        <path d="M15.2 2.5 8.8 11.5h6.4L18.4 7 15.2 2.5Z" fill="currentColor" fill-opacity="0.2" />
        <path d="M8.8 21.5 15.2 12.5H8.8L5.6 17l3.2 4.5Z" fill="currentColor" fill-opacity="0.14" />
      </>
    )
  }

  {/* Cairo ZK Pyramid */}
  {
    name === 'cairo' && (
      <>
        <polygon points="12 3 21 19 3 19" fill="currentColor" fill-opacity="0.14" />
        <polyline points="12 3 12 19" stroke-opacity="0.6" />
        <polyline points="7.5 11 16.5 11" stroke-opacity="0.6" />
      </>
    )
  }

  {/* Security Audit Shield */}
  {
    name === 'shield' && (
      <>
        <path
          d="M12 2.5 4.5 5.8v5.5c0 4.9 3.2 8.7 7.5 10.2 4.3-1.5 7.5-5.3 7.5-10.2V5.8L12 2.5Z"
          fill="currentColor"
          fill-opacity="0.14"
        />
        <path d="m9 12.2 2.1 2.1 4.1-4.3" />
      </>
    )
  }

  {/* Blockchain Cube */}
  {
    name === 'cube' && (
      <>
        <path d="M12 2.8 20 7.4v9.2l-8 4.6-8-4.6V7.4l8-4.6Z" fill="currentColor" fill-opacity="0.12" />
        <path d="M12 12 20 7.4M12 12 4 7.4M12 12v9.2" />
      </>
    )
  }

  {/* Vault Lock */}
  {
    name === 'vault' && (
      <>
        <rect x="4" y="10.5" width="16" height="10" rx="2.5" fill="currentColor" fill-opacity="0.14" />
        <path d="M8 10.5V7.5a4 4 0 0 1 8 0v3" />
        <circle cx="12" cy="15.5" r="1.4" fill="currentColor" stroke="none" />
      </>
    )
  }

  {/* Protocol Network Mesh */}
  {
    name === 'network' && (
      <>
        <circle cx="12" cy="5" r="2.2" fill="currentColor" fill-opacity="0.22" />
        <circle cx="5.5" cy="17.5" r="2.2" fill="currentColor" fill-opacity="0.22" />
        <circle cx="18.5" cy="17.5" r="2.2" fill="currentColor" fill-opacity="0.22" />
        <path d="M10.8 7 6.7 15.5M13.2 7l4.1 8.5M7.7 17.5h8.6" />
      </>
    )
  }

  {/* Terminal / Audit CLI */}
  {
    name === 'terminal' && (
      <>
        <rect x="3" y="4.5" width="18" height="15" rx="2.5" fill="currentColor" fill-opacity="0.1" />
        <path d="m7.5 9.5 3 2.5-3 2.5M12.5 14.5h4" />
      </>
    )
  }

  {/* Identity / EIP-712 Fingerprint */}
  {
    name === 'identity' && (
      <>
        <path d="M12 3a7 7 0 0 0-7 7v2" />
        <path d="M19 12v-2a7 7 0 0 0-4.2-6.4" />
        <path d="M8.5 10.5a3.5 3.5 0 0 1 7 0v3.5c0 2.2-.8 4.2-2.2 5.7" />
        <path d="M12 10.5v5.5c0 1.4-.4 2.7-1.1 3.8" />
        <path d="M6.2 15.5c.6 1.5 1.1 2.7 2.2 3.8" />
      </>
    )
  }

  {/* Liquidity Flow */}
  {
    name === 'liquidity' && (
      <>
        <path d="M4 8h13l-2.8-2.8" />
        <path d="M20 16H7l2.8 2.8" />
        <circle cx="6.5" cy="12" r="1.5" fill="currentColor" stroke="none" />
        <circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none" />
        <circle cx="17.5" cy="12" r="1.5" fill="currentColor" stroke="none" />
      </>
    )
  }
</svg>
