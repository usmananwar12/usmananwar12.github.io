---
import Logo from './Logo.astro';

const nav = [
  { href: '/#about', id: 'about', label: 'About' },
  { href: '/#experience', id: 'experience', label: 'Experience' },
  { href: '/#work', id: 'work', label: 'Work' },
  { href: '/#stack', id: 'stack', label: 'Stack' },
  { href: '/#research', id: 'research', label: 'Research' },
];
---

<header class="header" data-header>
  <div class="container bar">
    <a href="/" class="brand" aria-label="Usman Anwar, home">
      <Logo size={28} />
      <span class="brand-text">
        <span class="brand-name">Usman Anwar</span>
        <span class="brand-tag mono">web3.eng</span>
      </span>
    </a>

    <nav class="nav" aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} data-nav-link={item.id} data-scramble>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="actions">
      <div class="net-pill mono" aria-hidden="true" title="Multi-chain builder">
        <span class="live"></span>
        <span>5 CHAINS</span>
      </div>
      <button class="theme-btn" type="button" aria-label="Switch to light theme" data-theme-toggle>
        <svg class="sun" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"
          ></path>
        </svg>
        <svg class="moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"></path>
        </svg>
      </button>
      <a href="/#contact" class="btn btn-primary cta" data-magnetic>Contact</a>
      <button
        class="menu-btn"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open menu"
        data-menu-btn
      >
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div class="scroll-track" aria-hidden="true">
    <div class="scroll-bar" data-scroll-progress></div>
  </div>

  <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile" data-menu hidden>
    <ul class="container">
      {
        [...nav, { href: '/#contact', id: 'contact', label: 'Contact' }].map((item, i) => (
          <li>
            <a href={item.href}>
              <span class="mono m-idx">0{i + 1}</span>
              <span>{item.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 60;
    border-bottom: 1px solid transparent;
    transition:
      background 0.35s var(--ease),
      border-color 0.35s var(--ease),
      backdrop-filter 0.35s var(--ease),
      box-shadow 0.35s var(--ease);
  }
  .header.is-scrolled,
  .header.is-open {
    background: var(--header-bg);
    backdrop-filter: saturate(180%) blur(18px);
    -webkit-backdrop-filter: saturate(180%) blur(18px);
    border-bottom-color: var(--line);
    box-shadow: 0 12px 40px -20px rgb(0 0 0 / 0.65);
  }

  .bar {
    height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }
  .brand-name {
    font-weight: 600;
    letter-spacing: -0.025em;
    font-size: 15px;
  }
  .brand-tag {
    font-size: 10.5px;
    color: var(--accent-text);
    letter-spacing: 0.04em;
    margin-top: 2px;
  }

  .nav ul {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 4px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: rgb(var(--tint) / 0.025);
    backdrop-filter: blur(12px);
  }
  .nav a {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--fg-muted);
    transition:
      color 0.25s var(--ease),
      background 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }
  .nav a:hover,
  .nav a.is-active {
    color: var(--fg);
    background: rgb(var(--accent-rgb) / 0.12);
    box-shadow: 0 0 0 1px rgb(var(--accent-rgb) / 0.28) inset;
  }
  .nav a.is-active {
    color: var(--accent-text);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .net-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 32px;
    padding: 0 11px;
    border-radius: 999px;
    border: 1px solid rgb(var(--accent-rgb) / 0.24);
    background: rgb(var(--accent-rgb) / 0.06);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--accent-text);
  }
  .net-pill .live {
    width: 6px;
    height: 6px;
  }

  .cta {
    --h: 35px;
    padding: 0 16px;
    font-size: 13.5px;
  }

  .theme-btn {
    position: relative;
    display: grid;
    place-items: center;
    width: 35px;
    height: 35px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: rgb(var(--tint) / 0.03);
    color: var(--fg-muted);
    cursor: pointer;
    transition:
      color 0.25s var(--ease),
      border-color 0.25s var(--ease),
      background 0.25s var(--ease),
      transform 0.25s var(--spring);
  }
  .theme-btn:hover {
    color: var(--fg);
    border-color: rgb(var(--accent-rgb) / 0.4);
    background: rgb(var(--accent-rgb) / 0.08);
    transform: rotate(10deg);
  }
  .theme-btn svg {
    position: absolute;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.65;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition:
      transform 0.45s var(--ease),
      opacity 0.3s var(--ease);
  }
  .theme-btn .moon {
    opacity: 0;
    transform: rotate(-60deg) scale(0.6);
  }
  :global([data-theme='light']) .theme-btn .sun {
    opacity: 0;
    transform: rotate(60deg) scale(0.6);
  }
  :global([data-theme='light']) .theme-btn .moon {
    opacity: 1;
    transform: none;
  }

  .scroll-track {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: transparent;
    overflow: hidden;
  }
  .scroll-bar {
    height: 100%;
    width: 100%;
    transform-origin: 0 50%;
    transform: scaleX(0);
    background: linear-gradient(90deg, var(--accent), var(--cyan), var(--violet));
    box-shadow: 0 0 12px rgb(var(--accent-rgb) / 0.8);
  }

  .menu-btn {
    display: none;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: rgb(var(--tint) / 0.03);
    cursor: pointer;
    position: relative;
  }
  .menu-btn span {
    position: absolute;
    left: 11px;
    right: 11px;
    height: 1.5px;
    background: var(--fg);
    border-radius: 2px;
    transition: transform 0.3s var(--ease);
  }
  .menu-btn span:first-child {
    top: 15px;
  }
  .menu-btn span:last-child {
    top: 21px;
  }
  .menu-btn[aria-expanded='true'] span:first-child {
    transform: translateY(3px) rotate(45deg);
  }
  .menu-btn[aria-expanded='true'] span:last-child {
    transform: translateY(-3px) rotate(-45deg);
  }

  .mobile-nav ul {
    padding-block: 10px 24px;
  }
  .mobile-nav a {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 15px 0;
    font-size: 20px;
    font-weight: 540;
    letter-spacing: -0.02em;
    border-bottom: 1px solid var(--line);
  }
  .m-idx {
    font-size: 12px;
    color: var(--accent-text);
  }

  @media (max-width: 1020px) {
    .net-pill {
      display: none;
    }
  }
  @media (max-width: 820px) {
    .nav,
    .cta {
      display: none;
    }
    .menu-btn {
      display: block;
    }
  }
  @media (min-width: 821px) {
    .mobile-nav {
      display: none;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const themeBtn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
  const themeMeta = document.querySelector('[data-theme-color]');
  const syncThemeLabel = () => {
    const light = root.dataset.theme === 'light';
    themeBtn.setAttribute('aria-label', light ? 'Switch to dark theme' : 'Switch to light theme');
  };
  syncThemeLabel();
  themeBtn.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    themeMeta?.setAttribute('content', next === 'light' ? '#f3f6fc' : '#04060d');
    try {
      localStorage.setItem('theme', next);
    } catch {}
    syncThemeLabel();
  });

  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]')!;
  const menu = document.querySelector<HTMLElement>('[data-menu]')!;
  const progressBar = document.querySelector<HTMLElement>('[data-scroll-progress]');

  const onScroll = () => {
    header.classList.toggle('is-scrolled', window.scrollY > 8);
    if (progressBar) {
      const max = Math.max(document.documentElement.scrollHeight - window.innerHeight, 1);
      const ratio = Math.min(Math.max(window.scrollY / max, 0), 1);
      progressBar.style.transform = `scaleX(${ratio})`;
    }
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Active nav highlight based on visible section
  const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'));
  const sections = navLinks
    .map((a) => document.getElementById(a.dataset.navLink || ''))
    .filter((s): s is HTMLElement => !!s);

  if (sections.length && 'IntersectionObserver' in window) {
    const sio = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            navLinks.forEach((a) => a.classList.toggle('is-active', a.dataset.navLink === entry.target.id));
          }
        }
      },
      { rootMargin: '-38% 0px -52% 0px', threshold: 0 },
    );
    sections.forEach((s) => sio.observe(s));
  }

  const setOpen = (open: boolean) => {
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    menu.hidden = !open;
    header.classList.toggle('is-open', open);
  };
  btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
</script>
