---
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
import ChainIcon from './ChainIcon.astro';
import { experience } from '@/data/experience';

const dev = import.meta.env.DEV;
const isTodo = (s: string) => s.includes('TODO');
const showPeriod = (s: string) => (isTodo(s) ? 'Current role' : s);

const chainMeta: Record<string, { icon: 'evm' | 'starknet' | 'stellar' | 'xrpl' | 'solana'; color: string }> = {
  EVM: { icon: 'evm', color: '#38d9ff' },
  Starknet: { icon: 'starknet', color: '#a78bfa' },
  Stellar: { icon: 'stellar', color: '#2dffc4' },
  XRPL: { icon: 'xrpl', color: '#60a5fa' },
  Solana: { icon: 'solana', color: '#c084fc' },
};
---

<section id="experience" class="section" aria-labelledby="experience-title">
  <div class="container">
    <SectionHead index="02" label="Experience" id="experience-title">
      Shipping DeFi infrastructure <span class="dim">across five ecosystems.</span>
    </SectionHead>

    <ol class="chain-timeline">
      {
        experience.map((job, idx) => (
          <li class="block-item" data-reveal>
            <div class="spine" aria-hidden="true">
              <span class="node-ring">
                <span class="node-core"></span>
              </span>
              <span class="rail">
                <span class="rail-pulse"></span>
              </span>
            </div>

            <article class="block-card glass-card beam-card spotlight">
              <header class="block-top">
                <div class="block-meta">
                  <span class="mono block-num">BLOCK #{String(experience.length - idx).padStart(2, '0')}</span>
                  <p class:list={['mono period', { placeholder: dev && isTodo(job.period) }]}>
                    <span class="live" aria-hidden="true"></span>
                    {showPeriod(job.period)}
                  </p>
                </div>

                <ul class="chains" aria-label="Chains">
                  {job.chains.map((c) => {
                    const meta = chainMeta[c];
                    return (
                      <li class="chain-tag mono" style={meta ? `--ch-c:${meta.color}` : undefined}>
                        {meta && <ChainIcon name={meta.icon} size={13} />}
                        <span>{c}</span>
                      </li>
                    );
                  })}
                </ul>
              </header>

              <div class="body">
                <h3>
                  <span class="role">{job.role}</span>
                  <span class="at">
                    {job.companyUrl ? (
                      <a href={job.companyUrl} target="_blank" rel="noopener noreferrer" class="company">
                        {job.company} <Icon name="arrow-up-right" size={14} />
                      </a>
                    ) : (
                      <span class="company">{job.company}</span>
                    )}
                  </span>
                </h3>

                <p class="summary">{job.summary}</p>

                <ul class="focus">
                  {job.focus.map((f) => (
                    <li>{f}</li>
                  ))}
                </ul>

                {job.programs && job.programs.length > 0 && (
                  <div class="programs">
                    <p class="mono programs-label">Represented {job.company.split(' by ')[0]} at</p>
                    <ul>
                      {job.programs.map((p) => {
                        const meta = chainMeta[p.ecosystem];
                        return (
                          <li class="prog-card" style={meta ? `--p-c:${meta.color}` : undefined}>
                            <div class="prog-top">
                              {meta && (
                                <span class="prog-icon">
                                  <ChainIcon name={meta.icon} size={15} />
                                </span>
                              )}
                              <span class="mono pe">{p.ecosystem}</span>
                            </div>
                            <span class="pn">{p.name}</span>
                          </li>
                        );
                      })}
                    </ul>
                  </div>
                )}

                <ul class="stack" aria-label="Technologies">
                  {job.stack.map((s) => (
                    <li class="pill">{s}</li>
                  ))}
                </ul>
              </div>
            </article>
          </li>
        ))
      }

      <li class="block-item edu-item" data-reveal style="--d:1">
        <div class="spine" aria-hidden="true">
          <span class="node-ring genesis">
            <span class="node-core"></span>
          </span>
        </div>

        <article class="block-card edu-card glass-card spotlight">
          <div class="edu-row">
            <span class="mono block-num">GENESIS // EDUCATION</span>
            <h3>
              <span class="role">BS Computer Science</span>
              <span class="at"><span class="company">FAST-NUCES</span></span>
            </h3>
          </div>
        </article>
      </li>
    </ol>
  </div>
</section>

<style>
  .chain-timeline {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .block-item {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr);
    gap: 20px;
  }

  /* Vertical glowing blockchain spine */
  .spine {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 26px;
  }
  .node-ring {
    position: relative;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 1.5px solid rgb(var(--accent-rgb) / 0.55);
    background: rgb(var(--accent-rgb) / 0.12);
    display: grid;
    place-items: center;
    flex: none;
    box-shadow: 0 0 18px rgb(var(--accent-rgb) / 0.55);
  }
  .node-ring.genesis {
    border-color: rgb(var(--violet-rgb) / 0.6);
    background: rgb(var(--violet-rgb) / 0.14);
    box-shadow: 0 0 18px rgb(var(--violet-rgb) / 0.5);
  }
  .node-core {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }
  .node-ring.genesis .node-core {
    background: var(--violet-soft);
  }

  .rail {
    position: relative;
    width: 2px;
    flex: 1;
    margin-top: 10px;
    margin-bottom: -36px;
    background: linear-gradient(180deg, rgb(var(--accent-rgb) / 0.45), rgb(var(--violet-rgb) / 0.3));
    border-radius: 2px;
    overflow: hidden;
  }
  .rail-pulse {
    position: absolute;
    left: 0;
    right: 0;
    height: 80px;
    background: linear-gradient(180deg, transparent, var(--accent), var(--cyan), transparent);
    animation: rail-flow 3.6s ease-in-out infinite;
  }
  @keyframes rail-flow {
    0% {
      transform: translateY(-100%);
    }
    100% {
      transform: translateY(650%);
    }
  }

  /* Block Card */
  .block-card {
    padding: clamp(22px, 3.5vw, 36px);
    border-radius: 20px;
    overflow: hidden;
  }
  .block-card > * {
    position: relative;
    z-index: 1;
  }

  .block-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
    padding-bottom: 20px;
    margin-bottom: 24px;
    border-bottom: 1px solid var(--line);
  }
  .block-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }
  .block-num {
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--accent-text);
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px solid rgb(var(--accent-rgb) / 0.28);
    background: rgb(var(--accent-rgb) / 0.08);
  }
  .period {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12.5px;
    color: var(--fg-muted);
  }
  .period .live {
    width: 6px;
    height: 6px;
  }

  .chains {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }
  .chain-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 27px;
    padding: 0 10px;
    border-radius: 999px;
    font-size: 11.5px;
    color: var(--ch-c, var(--accent-text));
    border: 1px solid color-mix(in srgb, var(--ch-c, var(--accent)) 35%, transparent);
    background: color-mix(in srgb, var(--ch-c, var(--accent)) 10%, transparent);
    transition: transform 0.25s var(--spring), box-shadow 0.25s var(--ease);
  }
  :root[data-theme='light'] .chain-tag {
    color: var(--fg);
    background: color-mix(in srgb, var(--ch-c, var(--accent)) 13%, #ffffff);
  }
  .chain-tag:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 18px -6px var(--ch-c, var(--accent));
  }

  h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 12px;
    font-weight: inherit;
  }
  .role {
    font-size: clamp(22px, 2.6vw, 28px);
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .at {
    color: var(--accent-text);
    font-size: 16.5px;
    font-weight: 520;
  }
  .at::before {
    content: '@ ';
    font-family: var(--font-mono);
    font-size: 14px;
    opacity: 0.75;
  }
  .company {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--fg-muted);
  }
  a.company:hover {
    color: var(--fg);
  }

  .summary {
    margin-top: 16px;
    max-width: 72ch;
    color: var(--fg-muted);
    font-size: 16px;
    line-height: 1.72;
  }

  .focus {
    margin-top: 26px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px 24px;
  }
  .focus li {
    position: relative;
    padding: 12px 14px 12px 30px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: rgb(var(--tint) / 0.02);
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--fg);
    transition: border-color 0.25s var(--ease), background 0.25s var(--ease), transform 0.25s var(--ease);
  }
  .focus li:hover {
    border-color: rgb(var(--accent-rgb) / 0.32);
    background: rgb(var(--accent-rgb) / 0.045);
    transform: translateX(3px);
  }
  .focus li::before {
    content: '▸';
    position: absolute;
    left: 12px;
    top: 12px;
    color: var(--accent-text);
    font-size: 12px;
  }

  /* Programs Grid */
  .programs {
    margin-top: 30px;
  }
  .programs-label {
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-subtle);
    margin-bottom: 14px;
  }
  .programs ul {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }
  .prog-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 15px 16px;
    border-radius: 14px;
    border: 1px solid var(--line);
    background: linear-gradient(155deg, color-mix(in srgb, var(--p-c, var(--accent)) 8%, transparent), rgb(var(--tint) / 0.02));
    transition:
      border-color 0.25s var(--ease),
      transform 0.28s var(--spring),
      box-shadow 0.25s var(--ease);
  }
  .prog-card:hover {
    border-color: color-mix(in srgb, var(--p-c, var(--accent)) 55%, transparent);
    transform: translateY(-3px);
    box-shadow: 0 12px 28px -12px color-mix(in srgb, var(--p-c, var(--accent)) 60%, transparent);
  }
  .prog-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .prog-icon {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: color-mix(in srgb, var(--p-c, var(--accent)) 14%, transparent);
    color: var(--p-c, var(--accent-text));
  }
  .pe {
    font-size: 11px;
    color: var(--p-c, var(--accent-text));
    letter-spacing: 0.03em;
  }
  :root[data-theme='light'] .pe {
    color: var(--fg-muted);
  }
  .pn {
    font-size: 14.5px;
    font-weight: 560;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 26px;
    padding-top: 22px;
    border-top: 1px dashed var(--line);
  }

  .edu-card {
    padding: 22px clamp(22px, 3.5vw, 36px);
  }
  .edu-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px 24px;
  }
  .edu-card .role {
    font-size: clamp(19px, 2.2vw, 22px);
  }

  @media (max-width: 960px) {
    .programs ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 780px) {
    .block-item {
      grid-template-columns: minmax(0, 1fr);
    }
    .spine {
      display: none;
    }
    .focus {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 500px) {
    .programs ul {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
