---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
---

<Base title="Not found" description="This page doesn't exist.">
  <section class="nf container">
    <p class="mono code">404 · revert PageNotFound()</p>
    <h1>This page doesn't exist.</h1>
    <p class="sub">The link may be broken, or the page may have moved.</p>
    <a href="/" class="btn btn-primary">Back home <Icon name="arrow-right" /></a>
  </section>
</Base>

<style>
  .nf {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 18px;
  }
  .code {
    font-size: 13px;
    color: var(--accent);
  }
  h1 {
    font-size: clamp(36px, 6vw, 64px);
    letter-spacing: -0.045em;
    line-height: 1.04;
    font-weight: 580;
  }
  .sub {
    color: var(--fg-muted);
    margin-bottom: 12px;
  }
</style>
