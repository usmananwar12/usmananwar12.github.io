---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
---

<Base title="Not found" description="This page doesn't exist.">
  <section class="nf container">
    <div class="nf-card glass-card beam-card spotlight">
      <p class="mono code">
        <span class="live" aria-hidden="true"></span>
        <span>404 · revert PageNotFound()</span>
      </p>
      <h1>This page doesn't exist.</h1>
      <p class="sub">The link may be broken, or the page may have moved.</p>
      <a href="/" class="btn btn-primary" data-magnetic>Back home <Icon name="arrow-right" /></a>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: 74vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .nf-card {
    width: 100%;
    max-width: 640px;
    padding: clamp(28px, 5vw, 52px);
    border-radius: 22px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    overflow: hidden;
  }
  .nf-card > * {
    position: relative;
    z-index: 1;
  }
  .code {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 12.5px;
    color: var(--accent-text);
    padding: 5px 12px;
    border-radius: 999px;
    border: 1px solid rgb(var(--accent-rgb) / 0.3);
    background: rgb(var(--accent-rgb) / 0.08);
  }
  .code .live {
    width: 6px;
    height: 6px;
  }
  h1 {
    font-size: clamp(34px, 5.5vw, 54px);
    letter-spacing: -0.045em;
    line-height: 1.05;
    font-weight: 620;
  }
  .sub {
    color: var(--fg-muted);
    margin-bottom: 10px;
  }
</style>
